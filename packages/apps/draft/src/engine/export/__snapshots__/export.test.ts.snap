*{box-sizing:border-box}html{background:#fff;color:#202020}body{margin:0;font-family:Arimo,sans-serif;font-size:12pt;line-height:1.5}main{max-width:100%;overflow-wrap:anywhere}p{margin:0 0 8pt;white-space:pre-wrap}h1,h2,h3,h4,h5,h6{break-after:avoid;page-break-after:avoid}p,li{orphans:3;widows:3}a{color:inherit;text-decoration:underline}img{max-width:100%;height:auto;max-height:var(--image-height);object-fit:contain;vertical-align:middle;break-inside:avoid}table{border-collapse:collapse;table-layout:fixed;max-width:100%;margin-block:8pt}td,th{overflow-wrap:anywhere;min-width:0}th{font-weight:700;text-align:left}td p:last-child,th p:last-child{margin-bottom:0}tr{break-inside:avoid;page-break-inside:avoid}thead{display:table-header-group}tbody{break-inside:auto}ul,ol{padding-left:24pt}li>p{margin-block:0}li>ul,li>ol{margin-block:0}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-family:Cousine,monospace}blockquote{margin:8pt 18pt}hr{border:0;border-top:1px solid #808080;clear:both}nav{margin-block:12pt}nav p{margin-block:0}section.note{border-top:1px solid #808080;margin-top:18pt;padding-top:6pt;break-inside:avoid}section.note p{margin-left:24pt}section.note>a{float:left}sup,sub{line-height:0}mark{color:inherit}@media screen{body{padding:20mm;max-width:250mm;margin:auto}}@media print{html,body{margin:0;padding:0}body{-webkit-print-color-adjust:exact;print-color-adjust:exact}main{width:100%}a{color:inherit}img{float:none!important}pre,blockquote{break-inside:auto}}
